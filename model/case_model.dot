digraph TPN {
  rankdir=LR;
  graph [fontname="Helvetica", nodesep=0.18, ranksep=0.35, splines=true];
  node [fontname="Helvetica", fontsize=8];
  edge [arrowsize=0.6];
  "p_raw" [shape=circle, style=filled, fillcolor="#e8eef5", label="p_raw\n(2)"];
  "p_loading" [shape=circle, style=filled, fillcolor="#e8eef5", label="p_loading"];
  "p_wait_machine" [shape=circle, style=filled, fillcolor="#e8eef5", label="p_wait_machine"];
  "p_processing" [shape=circle, style=filled, fillcolor="#e8eef5", label="p_processing"];
  "p_wait_transfer" [shape=circle, style=filled, fillcolor="#e8eef5", label="p_wait_transfer"];
  "p_transferring" [shape=circle, style=filled, fillcolor="#e8eef5", label="p_transferring"];
  "p_wait_inspection" [shape=circle, style=filled, fillcolor="#e8eef5", label="p_wait_inspection"];
  "p_inspecting" [shape=circle, style=filled, fillcolor="#e8eef5", label="p_inspecting"];
  "p_rework_queue" [shape=circle, style=filled, fillcolor="#e8eef5", label="p_rework_queue"];
  "p_rework_transfer" [shape=circle, style=filled, fillcolor="#e8eef5", label="p_rework_transfer"];
  "p_wait_unload" [shape=circle, style=filled, fillcolor="#e8eef5", label="p_wait_unload"];
  "p_unloading" [shape=circle, style=filled, fillcolor="#e8eef5", label="p_unloading"];
  "p_completed" [shape=circle, style=filled, fillcolor="#e8eef5", label="p_completed"];
  "p_grip_recovery" [shape=circle, style=filled, fillcolor="#e8eef5", label="p_grip_recovery"];
  "p_robot_free" [shape=circle, style=filled, fillcolor="#e8eef5", label="p_robot_free\n(1)"];
  "p_machine_free" [shape=circle, style=filled, fillcolor="#e8eef5", label="p_machine_free\n(1)"];
  "p_inspection_free" [shape=circle, style=filled, fillcolor="#e8eef5", label="p_inspection_free\n(1)"];
  "t_StartLoading" [shape=box, style="rounded,filled", fillcolor="#f2f5f9", color="#04182e", label="t_StartLoading\n[1,2]"];
  "t_FinishLoading" [shape=box, style="rounded,filled", fillcolor="#f2f5f9", color="#04182e", label="t_FinishLoading\n[2,3]\n/load_done/"];
  "t_GripperSlipFault" [shape=box, style="rounded,filled", fillcolor="#f6e3d3", color="#b5651d", label="t_GripperSlipFault\n[0,1]"];
  "t_RecoverLoading" [shape=box, style="rounded,filled", fillcolor="#f2f5f9", color="#04182e", label="t_RecoverLoading\n[3,5]"];
  "t_StartProcessing" [shape=box, style="rounded,filled", fillcolor="#f2f5f9", color="#04182e", label="t_StartProcessing\n[0,1]"];
  "t_FinishProcessing" [shape=box, style="rounded,filled", fillcolor="#f2f5f9", color="#04182e", label="t_FinishProcessing\n[8,12]\n/machining_done/"];
  "t_StartTransfer" [shape=box, style="rounded,filled", fillcolor="#f2f5f9", color="#04182e", label="t_StartTransfer\n[1,2]"];
  "t_FinishTransfer" [shape=box, style="rounded,filled", fillcolor="#f2f5f9", color="#04182e", label="t_FinishTransfer\n[2,3]\n/transfer_done/"];
  "t_StartInspection" [shape=box, style="rounded,filled", fillcolor="#f2f5f9", color="#04182e", label="t_StartInspection\n[0,1]"];
  "t_InspectionPass" [shape=box, style="rounded,filled", fillcolor="#f2f5f9", color="#04182e", label="t_InspectionPass\n[4,6]\n/inspection_pass/"];
  "t_InspectionRework" [shape=box, style="rounded,filled", fillcolor="#f2f5f9", color="#04182e", label="t_InspectionRework\n[4,6]\n/inspection_rework/"];
  "t_StartReworkTransfer" [shape=box, style="rounded,filled", fillcolor="#f2f5f9", color="#04182e", label="t_StartReworkTransfer\n[1,2]"];
  "t_FinishReworkTransfer" [shape=box, style="rounded,filled", fillcolor="#f2f5f9", color="#04182e", label="t_FinishReworkTransfer\n[2,3]\n/rework_returned/"];
  "t_StartUnloading" [shape=box, style="rounded,filled", fillcolor="#f2f5f9", color="#04182e", label="t_StartUnloading\n[1,2]"];
  "t_FinishUnloading" [shape=box, style="rounded,filled", fillcolor="#f2f5f9", color="#04182e", label="t_FinishUnloading\n[2,3]\n/unload_done/"];
  "p_raw" -> "t_StartLoading";
  "p_robot_free" -> "t_StartLoading";
  "t_StartLoading" -> "p_loading";
  "p_loading" -> "t_FinishLoading";
  "t_FinishLoading" -> "p_wait_machine";
  "t_FinishLoading" -> "p_robot_free";
  "p_loading" -> "t_GripperSlipFault";
  "t_GripperSlipFault" -> "p_grip_recovery";
  "t_GripperSlipFault" -> "p_robot_free";
  "p_grip_recovery" -> "t_RecoverLoading";
  "p_robot_free" -> "t_RecoverLoading";
  "t_RecoverLoading" -> "p_loading";
  "p_wait_machine" -> "t_StartProcessing";
  "p_machine_free" -> "t_StartProcessing";
  "t_StartProcessing" -> "p_processing";
  "p_processing" -> "t_FinishProcessing";
  "t_FinishProcessing" -> "p_wait_transfer";
  "t_FinishProcessing" -> "p_machine_free";
  "p_wait_transfer" -> "t_StartTransfer";
  "p_robot_free" -> "t_StartTransfer";
  "t_StartTransfer" -> "p_transferring";
  "p_transferring" -> "t_FinishTransfer";
  "t_FinishTransfer" -> "p_wait_inspection";
  "t_FinishTransfer" -> "p_robot_free";
  "p_wait_inspection" -> "t_StartInspection";
  "p_inspection_free" -> "t_StartInspection";
  "t_StartInspection" -> "p_inspecting";
  "p_inspecting" -> "t_InspectionPass";
  "t_InspectionPass" -> "p_wait_unload";
  "t_InspectionPass" -> "p_inspection_free";
  "p_inspecting" -> "t_InspectionRework";
  "t_InspectionRework" -> "p_rework_queue";
  "t_InspectionRework" -> "p_inspection_free";
  "p_rework_queue" -> "t_StartReworkTransfer";
  "p_robot_free" -> "t_StartReworkTransfer";
  "t_StartReworkTransfer" -> "p_rework_transfer";
  "p_rework_transfer" -> "t_FinishReworkTransfer";
  "t_FinishReworkTransfer" -> "p_wait_machine";
  "t_FinishReworkTransfer" -> "p_robot_free";
  "p_wait_unload" -> "t_StartUnloading";
  "p_robot_free" -> "t_StartUnloading";
  "t_StartUnloading" -> "p_unloading";
  "p_unloading" -> "t_FinishUnloading";
  "t_FinishUnloading" -> "p_completed";
  "t_FinishUnloading" -> "p_robot_free";
}